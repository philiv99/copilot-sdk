{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Persistence": {
    "DataDirectory": "data",
    "Provider": "sqlite"
  },
  "Permissions": {
    "Mode": "AutoApproveLocalExecutor",
    "AllowedRoot": "C:\\development\\repos",
    "AllowedKinds": [ "shell", "write", "read" ],
    "DeniedCommandPatterns": [
      "Remove-Item\\s+-Recurse\\s+-Force\\s+C:\\\\",
      "rm\\s+-rf\\s+/",
      "format\\s+",
      "shutdown\\s+",
      "reg\\s+delete"
    ]
  }
}
