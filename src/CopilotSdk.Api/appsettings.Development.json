{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "CopilotSdk.Api.Managers.CopilotClientManager": "Debug",
      "CopilotSdk.Api.Services.AgentOrchestrationService": "Debug",
      "CopilotSdk.Api.EventHandlers.SessionEventDispatcher": "Debug"
    }
  },
  "CopilotClient": {
    "AutoStart": true
  },
  "Permissions": {
    "Mode": "AutoApproveLocalExecutor",
    "AllowedRoot": "C:\\development\\repos",
    "AllowedKinds": [ "shell", "write", "read", "custom-tool" ],
    "DeniedCommandPatterns": [
      "Remove-Item\\s+-Recurse\\s+-Force\\s+C:\\\\",
      "rm\\s+-rf\\s+/",
      "format\\s+",
      "shutdown\\s+",
      "reg\\s+delete"
    ]
  }
}
